# ==============================================================================
# OS & Editor Files (Junk generated by your computer)
# ==============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ==============================================================================
# Python & Backend (FastAPI, Pandas, Virtual Environments)
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# Frontend (Next.js / Node.js)
# ==============================================================================
# Dependencies
node_modules/

# Production builds
dist/
build/

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo
.vercel

# ==============================================================================
# Security & Secrets (CRITICAL)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
secrets.json

# ==============================================================================
# GovTech / Data Privacy (Preventing leaks of citizen data)
# ==============================================================================
*.csv
*.tsv
*.xlsx
*.xls
*.sqlite3
# (Unless explicitly added to custom below)

# ==============================================================================
# CUSTOM ADDITIONS
# Add any specific files, temporary logs, or testing datasets you want to ignore
# ==============================================================================

# Local docs & design tooling
docs/
.impeccable/

